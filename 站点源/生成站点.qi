// 奇语官网 博客 + 文档 静态站点生成器（狗粮：用奇语写）
//
// 构建时把内容渲染成静态 HTML，输出到 ../blog 和 ../docs，由 GitHub Pages 服务。
// 跑：cd 站点源 && qi run 生成站点.qi

包 主程序;

导入 标准库.输入输出 作为 IO;
导入 标准库.字符串;

// ============================================================
// 共享主题（深/浅切换，延续官网朱砂红水墨风）
// ============================================================
函数 页面CSS() : 字符串 {
    返回 "<style>"
    + ":root{--ink:#14110f;--ink2:#1c1916;--paper:#f4efe6;--dim:#b8af9f;--red:#d6442f;--red2:#e8674f;--gold:#d4ac57;--jade:#5cb494;--line:rgba(244,239,230,.10);--code:#1c1916;--codefg:#f4efe6;"
    + "--display:'Fraunces','Noto Serif SC',Georgia,serif;--mono:'JetBrains Mono',ui-monospace,Menlo,monospace;--sans:'Noto Sans SC',-apple-system,'PingFang SC',sans-serif;}"
    + "[data-theme=light]{--ink:#f5efe3;--ink2:#fffdf7;--paper:#221c17;--dim:#6e6457;--red:#c0392a;--red2:#d2543f;--gold:#9a7a2c;--jade:#2f7d60;--line:rgba(34,28,23,.13);}"
    + "*{margin:0;padding:0;box-sizing:border-box}html{scroll-behavior:smooth}"
    + "body{background:var(--ink);color:var(--paper);font-family:var(--sans);line-height:1.75;-webkit-font-smoothing:antialiased}"
    + "::selection{background:var(--red);color:#fdf2ee}a{color:var(--red2);text-decoration:none}a:hover{text-decoration:underline}"
    + "nav{position:sticky;top:0;z-index:10;backdrop-filter:blur(14px);background:var(--ink2);border-bottom:1px solid var(--line)}"
    + "nav .in{max-width:1140px;margin:0 auto;padding:0 24px;height:60px;display:flex;align-items:center;gap:24px}"
    + ".brand{display:flex;align-items:center;gap:10px;font-weight:700;font-size:18px}"
    + ".seal{width:32px;height:32px;border-radius:8px;display:grid;place-items:center;background:var(--red);color:#fdf2ee;font-family:var(--display);font-weight:800;font-size:20px}"
    + "nav a.nl{color:var(--dim);font-size:14.5px}nav a.nl:hover{color:var(--paper);text-decoration:none}nav a.nl.on{color:var(--paper);font-weight:600}"
    + ".tg{margin-left:auto;width:36px;height:36px;border-radius:8px;border:1px solid var(--line);background:none;color:var(--paper);cursor:pointer;font-size:16px}"
    + ".sun{display:none}[data-theme=light] .sun{display:inline}[data-theme=light] .moon{display:none}"
    + ".wrap{max-width:1140px;margin:0 auto;padding:44px 24px 80px;display:flex;gap:44px}"
    + ".side{flex:0 0 210px;position:sticky;top:84px;align-self:flex-start;max-height:calc(100vh - 100px);overflow-y:auto}"
    + ".side h4{font-size:12px;letter-spacing:1px;text-transform:uppercase;color:var(--gold);margin:18px 0 8px}"
    + ".side a{display:block;color:var(--dim);font-size:14px;padding:5px 0;border-left:2px solid transparent;padding-left:10px;margin-left:-12px}"
    + ".side a:hover{color:var(--paper);text-decoration:none}.side a.on{color:var(--red2);font-weight:600;border-left-color:var(--red)}"
    + ".main{flex:1;min-width:0;max-width:760px}"
    + "h1{font-family:var(--display);font-size:clamp(30px,5vw,44px);font-weight:800;letter-spacing:-1px;line-height:1.1;margin-bottom:14px}"
    + "h2{font-family:var(--display);font-size:26px;font-weight:700;margin:40px 0 12px;letter-spacing:-.5px;padding-top:8px}"
    + "h3{font-size:18px;font-weight:700;margin:26px 0 8px;color:var(--paper)}"
    + ".main p{margin:13px 0}.main ul,.main ol{margin:13px 0 13px 24px}.main li{margin:6px 0}"
    + ".lead{font-size:18px;color:var(--dim);margin-bottom:8px}"
    + ".meta{color:var(--dim);font-size:14px;margin-bottom:28px}"
    + "code{font-family:var(--mono);font-size:.88em;background:var(--ink2);padding:2px 6px;border-radius:5px;color:var(--red2)}"
    + "pre{background:var(--code);border:1px solid var(--line);border-radius:12px;padding:18px;overflow-x:auto;margin:16px 0}"
    + "pre code{background:none;padding:0;color:var(--codefg);font-size:13px;line-height:1.7}"
    + "table{border-collapse:collapse;width:100%;margin:16px 0;font-size:14px}th,td{border:1px solid var(--line);padding:8px 12px;text-align:left;vertical-align:top}th{color:var(--gold);font-weight:600}"
    + "blockquote{border-left:3px solid var(--red);padding:6px 16px;margin:16px 0;color:var(--dim);background:var(--ink2);border-radius:0 8px 8px 0}"
    + ".tip{border-left-color:var(--jade)}.warn{border-left-color:var(--gold)}"
    + ".pager{display:flex;justify-content:space-between;margin-top:48px;padding-top:24px;border-top:1px solid var(--line);font-size:14.5px}"
    + ".card{display:block;border:1px solid var(--line);border-radius:12px;padding:22px;margin:14px 0;background:var(--ink2);transition:border-color .2s,transform .15s}"
    + ".card:hover{border-color:var(--red);transform:translateY(-2px);text-decoration:none}.card .t{font-family:var(--display);font-size:21px;font-weight:700;color:var(--paper)}.card .d{color:var(--dim);font-size:14.5px;margin-top:6px}.card .m{color:var(--gold);font-size:13px;margin-top:10px}"
    + "footer{border-top:1px solid var(--line);padding:30px 24px;text-align:center;color:var(--dim);font-size:13.5px}"
    + "@media(max-width:760px){.wrap{flex-direction:column;gap:20px}.side{position:static;flex:none;max-height:none}}"
    + "</style>";
}

函数 主题脚本() : 字符串 {
    返回 "<script>(function(){try{var s=localStorage.getItem('qi-theme');var l=matchMedia('(prefers-color-scheme: light)').matches;if(s==='light'||(!s&&l))document.documentElement.setAttribute('data-theme','light');}catch(e){}})();</script>";
}
函数 切换脚本() : 字符串 {
    返回 "<script>document.getElementById('tg').onclick=function(){var d=document.documentElement;if(d.getAttribute('data-theme')==='light'){d.removeAttribute('data-theme');try{localStorage.setItem('qi-theme','dark')}catch(e){}}else{d.setAttribute('data-theme','light');try{localStorage.setItem('qi-theme','light')}catch(e){}}};</script>";
}
函数 页头(当前: 字符串) : 字符串 {
    变量 博客类: 字符串 = "nl";
    变量 文档类: 字符串 = "nl";
    如果 (字符串::等于(当前, "blog") == 1) { 博客类 = "nl on"; }
    如果 (字符串::等于(当前, "docs") == 1) { 文档类 = "nl on"; }
    返回 "<nav><div class=in>"
    + "<a class=brand href=\"/\"><span class=seal>奇</span> 奇语 Qi</a>"
    + "<a class=\"" + 文档类 + "\" href=\"/docs/\">文档</a>"
    + "<a class=\"" + 博客类 + "\" href=\"/blog/\">博客</a>"
    + "<a class=nl href=\"https://github.com/qilang-project/qi\">GitHub</a>"
    + "<button class=tg id=tg><span class=moon>🌙</span><span class=sun>☀️</span></button>"
    + "</div></nav>";
}
函数 页脚() : 字符串 {
    返回 "<footer>© 2026 奇语 Qi · MIT License · <a href=\"/\">qilang-project.github.io</a></footer>";
}
函数 包裹页面(标题: 字符串, 描述: 字符串, 当前: 字符串, 侧栏HTML: 字符串, 正文HTML: 字符串) : 字符串 {
    变量 主区: 字符串 = "<div class=main>" + 正文HTML + "</div>";
    变量 内容: 字符串;
    如果 (字符串::字节长度(侧栏HTML) == 0) {
        内容 = "<div class=wrap>" + 主区 + "</div>";
    } 否则 {
        内容 = "<div class=wrap><aside class=side>" + 侧栏HTML + "</aside>" + 主区 + "</div>";
    }
    返回 "<!DOCTYPE html><html lang=zh-CN><head><meta charset=UTF-8>"
    + "<meta name=viewport content=\"width=device-width,initial-scale=1\">"
    + "<title>" + 标题 + " — 奇语 Qi</title>"
    + "<meta name=description content=\"" + 描述 + "\">"
    + "<link rel=preconnect href=\"https://fonts.googleapis.com\"><link rel=preconnect href=\"https://fonts.gstatic.com\" crossorigin>"
    + "<link href=\"https://fonts.googleapis.com/css2?family=Fraunces:opsz,wght@9..144,600;9..144,800&family=Noto+Serif+SC:wght@700;800&family=Noto+Sans+SC:wght@400;500;700&family=JetBrains+Mono&display=swap\" rel=stylesheet>"
    + 主题脚本() + 页面CSS() + "</head><body>"
    + 页头(当前) + 内容 + 页脚() + 切换脚本()
    + "</body></html>";
}

// 上一页/下一页
函数 翻页(上网址: 字符串, 上文字: 字符串, 下网址: 字符串, 下文字: 字符串) : 字符串 {
    变量 左: 字符串 = "<span></span>";
    变量 右: 字符串 = "<span></span>";
    如果 (字符串::字节长度(上网址) > 0) { 左 = "<a href=\"" + 上网址 + "\">← " + 上文字 + "</a>"; }
    如果 (字符串::字节长度(下网址) > 0) { 右 = "<a href=\"" + 下网址 + "\">" + 下文字 + " →</a>"; }
    返回 "<div class=pager>" + 左 + 右 + "</div>";
}

// ============================================================
// 博客
// ============================================================
函数 博客首页正文() : 字符串 {
    返回 "<h1>奇语博客</h1>"
    + "<p class=lead>关于奇语设计、实现与生态的笔记。</p>"
    + "<a class=card href=\"/blog/为什么用中文关键字.html\"><div class=t>为什么用中文关键字</div><div class=d>母语编程不是噱头——它降低的是认知负荷。</div><div class=m>2026-05 · 设计</div></a>"
    + "<a class=card href=\"/blog/qi-web-122k-rps.html\"><div class=t>qi-web 跑到 122k RPS 之路</div><div class=d>从纯 qi 实现到热路径 Rust 化，比 Express 快 5.5 倍。</div><div class=m>2026-05 · 性能</div></a>"
    + "<a class=card href=\"/blog/编译器友好错误.html\"><div class=t>给编译器一张人话嘴</div><div class=d>把 LALRPOP 的 Debug 转储换成 rustc 风格的行列号 + 提示。</div><div class=m>2026-05 · 工具链</div></a>";
}
函数 文章_中文关键字() : 字符串 {
    返回 "<h1>为什么用中文关键字</h1><div class=meta>2026-05 · 设计</div>"
    + "<p>奇语（Qi）100% 用中文关键字：<code>函数</code> <code>变量</code> <code>如果</code> <code>当</code> <code>返回</code>。常被问的第一个问题是——这是噱头吗？</p>"
    + "<h2>认知负荷，而非语法糖</h2>"
    + "<p>对中文母语者，阅读 <code>如果 (年龄 >= 18) { 返回 真; }</code> 不需要把关键字在脑内翻译一遍。代码读起来像它本来描述的逻辑，而不是「英文 + 中文变量名」的混合体。</p>"
    + "<blockquote>关键字是用得最频繁的词。把这层摩擦去掉，初学者的入门曲线明显变平。</blockquote>"
    + "<h2>它仍然是真编译语言</h2>"
    + "<p>中文只在词法层。下面这段经过 LALRPOP 解析 → LLVM IR → 原生机器码，没有解释器：</p>"
    + "<pre><code>包 主程序;\n导入 标准库.输入输出 作为 IO;\n\n函数 斐波那契(n: 整数) : 整数 {\n    如果 (n &lt; 2) { 返回 n; }\n    返回 斐波那契(n - 1) + 斐波那契(n - 2);\n}\n\n函数 入口() {\n    IO.打印行(\"fib(10) = \" + 整数转字符串(斐波那契(10)));\n}</code></pre>"
    + "<h2>代价：解析器的取舍</h2>"
    + "<p>中文标识符和中文关键字共享字符空间，带来一些 LALR(1) 上的纠结——比如 <code>结果</code> <code>类型</code> 是保留字，暂时不能直接当变量名（泛型 <code>结果&lt;T,E&gt;</code> 的 <code>&lt;</code> 歧义）。我们选择诚实地把这些列成<a href=\"/docs/保留字.html\">保留字地雷</a>，而不是假装没有。</p>"
    + "<p><a href=\"/docs/\">→ 读文档开始写奇语</a></p>";
}
函数 文章_性能() : 字符串 {
    返回 "<h1>qi-web 跑到 122k RPS 之路</h1><div class=meta>2026-05 · 性能</div>"
    + "<p>qi-web 是用奇语写的 Web 框架，风格像 Express / Fiber。一开始纯 qi 实现，吞吐一般；通过把热路径 Rust 化，最终实测 <strong>~122k RPS</strong>——比 Express 快约 5.5 倍，比 Node.js 快约 25%。</p>"
    + "<h2>瓶颈在哪</h2>"
    + "<ul><li><strong>GC 全局锁</strong>：<code>Mutex&lt;RuntimeEnvironment&gt;</code> 是真正的 hot path 杀手，换成 <code>RwLock</code> + 原子计数后明显改善。</li>"
    + "<li><strong>请求解析</strong>：把字符串切分密集的解析下沉到 Rust。</li>"
    + "<li><strong>路由匹配</strong>：用 Rust 侧的 trie 镜像，qi 层只做注册。</li></ul>"
    + "<h2>最小服务器长这样</h2>"
    + "<pre><code>包 主程序;\n导入 Web::{应用, 上下文, 响应, 创建应用, 配置, 获取, 文本, 运行应用};\n\n函数 处理(上下文值: 上下文) : 响应 {\n    返回 文本(\"ok\");\n}\n\n函数 入口() {\n    变量 应用值: 应用 = 创建应用();\n    应用值 = 配置(应用值, \"127.0.0.1\", 6790);\n    应用值 = 获取(应用值, \"/\", 处理);\n    运行应用(应用值);\n}</code></pre>"
    + "<blockquote>性能不是吹的——基准用 <code>wrk -t4 -c100 -d10s</code> 实测。</blockquote>";
}
函数 文章_错误() : 字符串 {
    返回 "<h1>给编译器一张人话嘴</h1><div class=meta>2026-05 · 工具链</div>"
    + "<p>早期奇语的语法错误长这样：</p>"
    + "<pre><code>解析错误: General(\"UnrecognizedToken { token: (3206,\n  Token(110, \\\"结果\\\"), 3212), expected: [...] }\")</code></pre>"
    + "<p>没行号、没源码、看不懂。现在换成 rustc 风格：</p>"
    + "<pre><code>语法错误：意外的标记 `结果`\n  --&gt; 第 3 行第 8 列\n   3 |     变量 结果: 整数 = 1;\n                ^^^^^^\n  期望：&lt;标识符&gt; / 长度\n  提示：`结果` 是 qi 的保留字，不能作为标识符名。换个别名（如 `结果值`）</code></pre>"
    + "<h2>关键改动</h2>"
    + "<ul><li>把 LALRPOP 的 <code>ParseError</code> 翻译成带 1-based 行/列的友好消息</li>"
    + "<li>源码行 + caret 高亮出错位置</li>"
    + "<li>智能提示：期望 <code>;</code> → 「上一行可能漏写分号」；token 是保留字 → 「换个别名」</li></ul>"
    + "<p>错误信息的质量，往往决定一门新语言「能不能用得下去」。</p>";
}

// ============================================================
// 文档侧栏
// ============================================================
函数 文档侧栏(当前: 字符串) : 字符串 {
    返回 "<h4>开始</h4>"
    + 侧栏链接(当前, "index", "/docs/", "简介")
    + 侧栏链接(当前, "install", "/docs/安装.html", "安装")
    + 侧栏链接(当前, "first", "/docs/第一个程序.html", "第一个程序")
    + "<h4>语言</h4>"
    + 侧栏链接(当前, "syntax", "/docs/基础语法.html", "变量与类型")
    + 侧栏链接(当前, "func", "/docs/函数与方法.html", "函数与方法")
    + 侧栏链接(当前, "flow", "/docs/控制流.html", "控制流")
    + 侧栏链接(当前, "struct", "/docs/结构体与枚举.html", "结构体与枚举")
    + 侧栏链接(当前, "err", "/docs/错误处理.html", "错误处理")
    + 侧栏链接(当前, "async", "/docs/异步.html", "异步与协程")
    + 侧栏链接(当前, "module", "/docs/包与模块.html", "包与模块")
    + "<h4>标准库</h4>"
    + 侧栏链接(当前, "stdlib", "/docs/标准库.html", "总览")
    + 侧栏链接(当前, "io", "/docs/输入输出.html", "输入输出与文件")
    + 侧栏链接(当前, "str", "/docs/字符串.html", "字符串")
    + 侧栏链接(当前, "json", "/docs/JSON.html", "JSON")
    + 侧栏链接(当前, "net", "/docs/网络.html", "网络与 HTTP")
    + 侧栏链接(当前, "llm", "/docs/大模型.html", "大模型")
    + "<h4>生态</h4>"
    + 侧栏链接(当前, "frameworks", "/docs/框架.html", "Web / CLI / Agent")
    + "<h4>参考</h4>"
    + 侧栏链接(当前, "tool", "/docs/命令行工具.html", "命令行工具")
    + 侧栏链接(当前, "reserved", "/docs/保留字.html", "保留字与陷阱")
    + 侧栏链接(当前, "faq", "/docs/常见问题.html", "常见问题")
    + 侧栏链接(当前, "ai", "/docs/给AI.html", "给 AI / Agent");
}
函数 侧栏链接(当前: 字符串, 键: 字符串, 网址: 字符串, 文字: 字符串) : 字符串 {
    变量 类名: 字符串 = "";
    如果 (字符串::等于(当前, 键) == 1) { 类名 = " class=on"; }
    返回 "<a" + 类名 + " href=\"" + 网址 + "\">" + 文字 + "</a>";
}

// ============================================================
// 文档页 —— 开始
// ============================================================
函数 文档_简介() : 字符串 {
    返回 "<h1>奇语 Qi 文档</h1>"
    + "<p class=lead>100% 中文关键字、编译到原生机器码的系统级编程语言。</p>"
    + "<p>奇语基于 LLVM 生成原生可执行文件，内置 Go 式 M:N 协程异步运行时，配套编译器、Web 框架、CLI 框架、LLM Agent 框架、语言服务器与完整工具链。</p>"
    + "<h2>三十秒上手</h2>"
    + "<pre><code>curl -fsSL https://raw.githubusercontent.com/qilang-project/qi/main/scripts/install.sh | bash</code></pre>"
    + "<pre><code>包 主程序;\n导入 标准库.输入输出 作为 IO;\n函数 入口() { IO.打印行(\"你好，奇语！\"); }</code></pre>"
    + "<pre><code>qi run 你好.qi</code></pre>"
    + "<h2>文档导航</h2>"
    + "<ul><li><strong>语言</strong>：<a href=\"/docs/基础语法.html\">变量与类型</a> · <a href=\"/docs/函数与方法.html\">函数与方法</a> · <a href=\"/docs/控制流.html\">控制流</a> · <a href=\"/docs/结构体与枚举.html\">结构体与枚举</a> · <a href=\"/docs/错误处理.html\">错误处理</a> · <a href=\"/docs/异步.html\">异步</a> · <a href=\"/docs/包与模块.html\">包与模块</a></li>"
    + "<li><strong>标准库</strong>：<a href=\"/docs/标准库.html\">总览</a> · <a href=\"/docs/输入输出.html\">IO</a> · <a href=\"/docs/字符串.html\">字符串</a> · <a href=\"/docs/JSON.html\">JSON</a> · <a href=\"/docs/网络.html\">网络/HTTP</a> · <a href=\"/docs/大模型.html\">大模型</a></li>"
    + "<li><strong>参考</strong>：<a href=\"/docs/命令行工具.html\">命令行工具</a> · <a href=\"/docs/保留字.html\">保留字与陷阱</a> · <a href=\"/docs/常见问题.html\">FAQ</a></li></ul>"
    + 翻页("", "", "/docs/安装.html", "安装");
}
函数 文档_安装() : 字符串 {
    返回 "<h1>安装</h1>"
    + "<h2>一键脚本（macOS / Linux）</h2>"
    + "<pre><code>curl -fsSL https://raw.githubusercontent.com/qilang-project/qi/main/scripts/install.sh | bash</code></pre>"
    + "<p>脚本自动探测平台（macos-arm64 / macos-x64 / linux-x64），从 GitHub Releases 拉预编译二进制，装到 <code>/usr/local/bin</code>（无权限自动降级到 <code>$HOME/.local/bin</code> 并提示加 PATH）。</p>"
    + "<p>装到自定义目录：</p><pre><code>curl -fsSL .../install.sh | INSTALL_DIR=$HOME/bin bash</code></pre>"
    + "<h2>从源码构建</h2>"
    + "<p>需要 Rust 1.75+、LLVM 15、Clang。</p>"
    + "<pre><code>git clone https://github.com/qilang-project/qi.git\ncd qi\ncargo build --release\n# 二进制在 ./target/release/qi</code></pre>"
    + "<table><tr><th>平台</th><th>装 LLVM 15</th></tr>"
    + "<tr><td>Linux</td><td><code>wget https://apt.llvm.org/llvm.sh &amp;&amp; chmod +x llvm.sh &amp;&amp; sudo ./llvm.sh 15</code></td></tr>"
    + "<tr><td>macOS</td><td><code>brew install llvm@15 &amp;&amp; export LLVM_SYS_150_PREFIX=$(brew --prefix llvm@15)</code></td></tr></table>"
    + "<blockquote class=tip>验证安装：<code>qi info --version</code></blockquote>"
    + 翻页("/docs/", "简介", "/docs/第一个程序.html", "第一个程序");
}
函数 文档_第一个程序() : 字符串 {
    返回 "<h1>第一个程序</h1>"
    + "<p>每个奇语程序都以包声明开头，入口函数叫 <code>入口</code>。</p>"
    + "<pre><code>包 主程序;\n导入 标准库.输入输出 作为 IO;\n\n函数 入口() {\n    IO.打印行(\"你好，奇语！\");\n}</code></pre>"
    + "<h2>编译器命令</h2>"
    + "<pre><code>qi run 你好.qi      # 编译并运行\nqi check 你好.qi    # 只检查语法\nqi compile 你好.qi -o 你好   # 编译成原生可执行文件\nqi format 你好.qi -i # 格式化</code></pre>"
    + "<h2>稍微大一点的例子</h2>"
    + "<pre><code>包 主程序;\n导入 标准库.输入输出 作为 IO;\n\n函数 阶乘(n: 整数) : 整数 {\n    如果 (n &lt;= 1) { 返回 1; }\n    返回 n * 阶乘(n - 1);\n}\n\n函数 入口() {\n    变量 i: 整数 = 1;\n    当 (i &lt;= 5) {\n        IO.打印行(整数转字符串(i) + \"! = \" + 整数转字符串(阶乘(i)));\n        i = i + 1;\n    }\n}</code></pre>"
    + "<blockquote class=tip>用 <code>IO.打印行</code> 而不是裸 <code>打印</code>；示例端口用随机高位端口（3076 / 6759），别用 8080。</blockquote>"
    + 翻页("/docs/安装.html", "安装", "/docs/基础语法.html", "变量与类型");
}

// ============================================================
// 文档页 —— 语言
// ============================================================
函数 文档_基础语法() : 字符串 {
    返回 "<h1>变量与类型</h1>"
    + "<h2>变量与常量</h2>"
    + "<pre><code>变量 名字 = \"奇语\";          // 类型推断\n变量 年龄: 整数 = 10;         // 显式类型\n常量 PI = 3.14159;            // 不可变常量</code></pre>"
    + "<h2>基础类型</h2>"
    + "<table><tr><th>类型</th><th>含义</th><th>LLVM 实际</th></tr>"
    + "<tr><td>整数</td><td>整数（<strong>默认 64 位</strong>）</td><td>i64</td></tr>"
    + "<tr><td>长整数 / 短整数 / 字节</td><td>64 / 16 / 8 位</td><td>i64 / i16 / i8</td></tr>"
    + "<tr><td>浮点数</td><td>64 位浮点</td><td>double</td></tr>"
    + "<tr><td>布尔</td><td>真 / 假</td><td>i1</td></tr>"
    + "<tr><td>字符串</td><td>UTF-8 字符串</td><td>ptr</td></tr>"
    + "<tr><td>空</td><td>无返回值</td><td>void</td></tr></table>"
    + "<blockquote class=warn><code>整数</code> 映射为 <strong>i64</strong>（不是 i32）。需要更窄类型用 <code>短整数</code> / <code>字节</code>。</blockquote>"
    + "<h2>运算符</h2>"
    + "<p>算术 <code>+ - * / %</code>，比较 <code>== != &lt; &lt;= &gt; &gt;=</code>，逻辑 <code>&amp;&amp; || !</code>。布尔字面量 <code>真</code> / <code>假</code>。</p>"
    + "<h2>数组</h2>"
    + "<pre><code>变量 数 = [1, 2, 3, 4, 5];\nIO.打印(数[0]);          // 第一个元素\n变量 长度值 = 数.长度;    // 长度</code></pre>"
    + "<h2>字符串拼接</h2>"
    + "<pre><code>变量 招呼 = \"你好，\" + 名字 + \"！\";\n// 数字转字符串再拼\n变量 行 = \"年龄 = \" + 整数转字符串(年龄);</code></pre>"
    + 翻页("/docs/第一个程序.html", "第一个程序", "/docs/函数与方法.html", "函数与方法");
}
函数 文档_函数() : 字符串 {
    返回 "<h1>函数与方法</h1>"
    + "<h2>函数</h2>"
    + "<pre><code>函数 加法(x: 整数, y: 整数) : 整数 {\n    返回 x + y;\n}\n\n// 无返回值省略返回类型\n函数 打招呼(名字: 字符串) {\n    IO.打印行(\"你好，\" + 名字);\n}</code></pre>"
    + "<h2>函数作为参数（高阶函数）</h2>"
    + "<pre><code>函数 应用两次(f: 函数(整数): 整数, x: 整数) : 整数 {\n    返回 f(f(x));\n}</code></pre>"
    + "<p>函数指针类型写作 <code>函数(参数类型...): 返回类型</code>。回调签名固定，注意返回类型要一致。</p>"
    + "<h2>方法（Go 风格）</h2>"
    + "<p>方法是接收者写在函数名前括号里的函数，<strong>不是</strong> <code>方法 类型.名()</code>：</p>"
    + "<pre><code>类型 点 {\n    x: 浮点数,\n    y: 浮点数,\n}\n\n函数 (自己 点) 模长平方() : 浮点数 {\n    返回 自己.x * 自己.x + 自己.y * 自己.y;\n}\n\n函数 入口() {\n    变量 p = (点 { x: 3.0, y: 4.0 });\n    IO.打印行(浮点数转字符串(p.模长平方()));  // 25.0\n}</code></pre>"
    + "<blockquote class=tip>接收者名可以用 <code>自己</code>。结构体字面量里每个字段单独赋值，别把多个字段都从同一个参数取（已知 codegen 踩坑）。</blockquote>"
    + 翻页("/docs/基础语法.html", "变量与类型", "/docs/控制流.html", "控制流");
}
函数 文档_控制流() : 字符串 {
    返回 "<h1>控制流</h1>"
    + "<h2>条件</h2>"
    + "<pre><code>如果 (年龄 >= 18) {\n    IO.打印行(\"成年\");\n} 否则 如果 (年龄 >= 12) {\n    IO.打印行(\"少年\");\n} 否则 {\n    IO.打印行(\"儿童\");\n}</code></pre>"
    + "<h2>当循环（while）</h2>"
    + "<pre><code>变量 计数 = 0;\n当 (计数 &lt; 5) {\n    IO.打印(计数);\n    计数 = 计数 + 1;\n}</code></pre>"
    + "<h2>对于循环（for）</h2>"
    + "<pre><code>对于 i 在 0..10 {\n    IO.打印(i);\n}</code></pre>"
    + "<h2>无限循环 + 跳出 / 继续</h2>"
    + "<pre><code>循环 {\n    如果 (条件) { 跳出; }      // break\n    如果 (其他) { 继续; }      // continue\n}</code></pre>"
    + "<h2>匹配（模式匹配）</h2>"
    + "<pre><code>匹配 值 {\n    1 => IO.打印行(\"一\"),\n    2 => IO.打印行(\"二\"),\n    _ => IO.打印行(\"其他\"),\n}</code></pre>"
    + 翻页("/docs/函数与方法.html", "函数与方法", "/docs/结构体与枚举.html", "结构体与枚举");
}
函数 文档_结构体() : 字符串 {
    返回 "<h1>结构体与枚举</h1>"
    + "<h2>结构体</h2>"
    + "<pre><code>类型 用户 {\n    姓名: 字符串,\n    年龄: 整数,\n}\n\n// 构造（两种写法）\n变量 张三 = 新建 用户 { 姓名: \"张三\", 年龄: 25 };\n变量 李四 = (用户 { 姓名: \"李四\", 年龄: 30 });\n\n// 字段访问\nIO.打印行(张三.姓名);</code></pre>"
    + "<blockquote class=warn>用 <code>类型</code> 或 <code>结构体</code> 声明都行。字段名后跟逗号。</blockquote>"
    + "<h2>方法</h2>"
    + "<pre><code>函数 (自己 用户) 介绍() : 字符串 {\n    返回 自己.姓名 + \"，\" + 整数转字符串(自己.年龄) + \" 岁\";\n}</code></pre>"
    + "<h2>枚举</h2>"
    + "<pre><code>枚举 状态 {\n    就绪,\n    运行中,\n    完成,\n    错误,\n}</code></pre>"
    + "<p>配合 <a href=\"/docs/控制流.html\">匹配</a> 使用枚举变体。</p>"
    + 翻页("/docs/控制流.html", "控制流", "/docs/错误处理.html", "错误处理");
}
函数 文档_错误处理() : 字符串 {
    返回 "<h1>错误处理</h1>"
    + "<h2>尝试 / 捕获 / 最终</h2>"
    + "<pre><code>尝试 {\n    变量 内容 = IO::读取文件(\"数据.txt\");\n    IO.打印行(内容);\n} 捕获 错误值 {\n    IO.打印行(\"出错：\" + 错误值);\n} 最终 {\n    IO.打印行(\"清理完成\");\n}</code></pre>"
    + "<h2>返回值约定（FFI）</h2>"
    + "<p>很多标准库函数用返回值表示成败，约定<strong>不完全统一</strong>，用前确认：</p>"
    + "<table><tr><th>函数</th><th>成功</th><th>失败</th></tr>"
    + "<tr><td>读取文件 / 字符串函数</td><td>结果</td><td>空串 <code>\"\"</code></td></tr>"
    + "<tr><td>写入文件 / 追加文件</td><td><code>1</code></td><td><code>0</code></td></tr>"
    + "<tr><td>设置环境变量</td><td><code>1</code></td><td><code>-1</code></td></tr>"
    + "<tr><td>文件大小</td><td>字节数</td><td><code>-1</code></td></tr></table>"
    + "<blockquote class=tip>字符串类 FFI 失败返回空串（不是 NULL），所以 <code>读取文件(...) + \"后缀\"</code> 拼接是安全的。用 <code>字符串::字节长度(x) == 0</code> 检测失败。</blockquote>"
    + 翻页("/docs/结构体与枚举.html", "结构体与枚举", "/docs/异步.html", "异步与协程");
}
函数 文档_异步() : 字符串 {
    返回 "<h1>异步与协程</h1>"
    + "<p>奇语用 <code>未来&lt;T&gt;</code> 类型 + <code>等待</code> 表达式做异步，底层是 Go 式 M:N 协程调度器（work-stealing）。</p>"
    + "<pre><code>函数 异步计算(值: 整数) : 未来&lt;整数&gt; {\n    返回 值 * 2;   // 自动包装成 Future\n}\n\n函数 入口() {\n    变量 结果值: 整数 = 等待 异步计算(21);\n    IO.打印行(整数转字符串(结果值));   // 42\n}</code></pre>"
    + "<h2>支持的 Future 类型</h2>"
    + "<ul><li><code>未来&lt;整数&gt;</code> / <code>未来&lt;浮点数&gt;</code> / <code>未来&lt;布尔&gt;</code> / <code>未来&lt;字符串&gt;</code></li></ul>"
    + "<h2>协程与通道</h2>"
    + "<pre><code>变量 信道 = 通道&lt;整数&gt;();\n启动 发送者(信道);\n变量 值 = &lt;- 信道;</code></pre>"
    + "<h2>Select 多路复用</h2>"
    + "<pre><code>选择 {\n    情况 值 = &lt;- 通道1 { IO.打印(值); }\n    情况 文本 = &lt;- 通道2 { IO.打印行(文本); }\n}</code></pre>"
    + "<blockquote class=warn>完整 async/await 状态机 codegen 约覆盖 70%；复杂控制流内嵌 await 会退化到同步包装，行为正确但非真协程切换。</blockquote>"
    + 翻页("/docs/错误处理.html", "错误处理", "/docs/包与模块.html", "包与模块");
}
函数 文档_包与模块() : 字符串 {
    返回 "<h1>包与模块</h1>"
    + "<h2>包声明</h2>"
    + "<p>可执行程序用 <code>包 主程序;</code>，库用自己的包名。</p>"
    + "<h2>导入标准库</h2>"
    + "<pre><code>导入 标准库.输入输出 作为 IO;   // 别名\n导入 标准库.HTTP;               // 直接用 HTTP.获取(...)\n导入 标准库.字符串;             // 字符串::字节长度(...)</code></pre>"
    + "<h2>调用方式</h2>"
    + "<ul><li><code>.</code> 方法调用：<code>HTTP.获取(网址)</code></li>"
    + "<li><code>::</code> 静态方法：<code>字符串::子串(s, 0, 3)</code></li></ul>"
    + "<h2>跨包导入（使用 qi 写的库）</h2>"
    + "<pre><code>导入 Web::{ 创建应用, 启动 };                    // qi-web\n导入 CLI::{ 创建应用, 创建命令, 执行 };          // qi-cli\n导入 Harness::{ 大模型, 开启会话, 创建代理 };    // qi-harness</code></pre>"
    + "<blockquote class=warn>跨包用 destructure 列出要用的符号，<strong>不支持</strong> <code>Web::函数()</code> 这种跨包静态调用。命名空间用 <code>.</code> 分隔不用 <code>::</code>。</blockquote>"
    + 翻页("/docs/异步.html", "异步与协程", "/docs/标准库.html", "标准库总览");
}

// ============================================================
// 文档页 —— 标准库
// ============================================================
函数 文档_标准库() : 字符串 {
    返回 "<h1>标准库总览</h1>"
    + "<p>25+ 模块，用 <code>导入 标准库.X</code> 引入。</p>"
    + "<table><tr><th>模块</th><th>用途</th></tr>"
    + "<tr><td><a href=\"/docs/输入输出.html\">输入输出</a></td><td>打印、文件读写</td></tr>"
    + "<tr><td><a href=\"/docs/字符串.html\">字符串</a>（= 文本）</td><td>查找/子串/替换/分割</td></tr>"
    + "<tr><td><a href=\"/docs/JSON.html\">JSON</a></td><td>对象/数组构建与序列化</td></tr>"
    + "<tr><td><a href=\"/docs/网络.html\">HTTP / 网络</a></td><td>HTTP 客户端服务端、TCP/UDP</td></tr>"
    + "<tr><td><a href=\"/docs/大模型.html\">大模型</a></td><td>OpenAI 兼容 LLM 调用</td></tr>"
    + "<tr><td>加密</td><td>MD5 / SHA256 / SHA512 / HMAC / Base64</td></tr>"
    + "<tr><td>时间</td><td>当前时间、格式化、睡眠</td></tr>"
    + "<tr><td>操作系统</td><td>环境变量、系统信息、目录</td></tr>"
    + "<tr><td>正则 / 路径 / 随机 / 压缩 / 数据库 / 配置 / 进程 / 命令行 / 列表 / 哈希表 / 向量 / 图形化 / 测试 / MCP服务器 / WebSocket</td><td>各类工具模块</td></tr></table>"
    + "<h2>加密示例</h2>"
    + "<pre><code>导入 标准库.加密;\n变量 哈希值 = 加密.SHA256哈希(\"数据\");\n变量 编码值 = 加密.Base64编码(\"数据\");</code></pre>"
    + "<h2>时间示例</h2>"
    + "<pre><code>导入 标准库.时间;\n变量 现在 = 时间.当前毫秒();\n时间.睡眠毫秒(100);</code></pre>"
    + 翻页("/docs/包与模块.html", "包与模块", "/docs/输入输出.html", "输入输出与文件");
}
函数 文档_输入输出() : 字符串 {
    返回 "<h1>输入输出与文件</h1>"
    + "<pre><code>导入 标准库.输入输出 作为 IO;\n\nIO.打印行(\"换行输出\");\nIO.打印(\"不换行\");\n\n变量 内容: 字符串 = IO::读取文件(\"文件.txt\");   // 失败返回空串\nIO::写入文件(\"文件.txt\", \"内容\");              // 1=成功 0=失败\nIO::追加文件(\"文件.txt\", \"更多\");\n变量 大小: 整数 = IO::文件大小(\"文件.txt\");       // 不存在返回 -1\nIO::创建目录(\"新目录\");\nIO::删除文件(\"旧.txt\");</code></pre>"
    + "<blockquote class=tip>检测读取失败：<code>如果 (字符串::字节长度(内容) == 0) { ... }</code></blockquote>"
    + 翻页("/docs/标准库.html", "标准库总览", "/docs/字符串.html", "字符串");
}
函数 文档_字符串() : 字符串 {
    返回 "<h1>字符串</h1>"
    + "<p>字符串模块<strong>同时注册为</strong> <code>标准库.字符串</code> 和 <code>标准库.文本</code>，所以 <code>字符串::X</code> 和 <code>文本.X</code> 都能用。</p>"
    + "<pre><code>导入 标准库.字符串;\n\n变量 长度 = 字符串::字节长度(\"你好\");      // 6（UTF-8 字节）\n变量 字符数 = 字符串::字符数(\"你好\");      // 2\n变量 位置 = 字符串::查找(\"你好世界\", \"世界\"); // 找不到返回 -1\n变量 子 = 字符串::子串(\"你好世界\", 0, 6);\n变量 大 = 字符串::转大写(\"hello\");\n变量 含 = 字符串::包含(\"你好世界\", \"你好\");   // 0/1\n变量 等 = 字符串::等于(\"a\", \"a\");           // 0/1\n变量 新 = 字符串::替换(\"a-b\", \"-\", \"+\");</code></pre>"
    + "<blockquote class=warn>字符串函数失败（如 null / 非法 UTF-8）返回空串，不是 NULL。</blockquote>"
    + 翻页("/docs/输入输出.html", "输入输出与文件", "/docs/JSON.html", "JSON");
}
函数 文档_JSON() : 字符串 {
    返回 "<h1>JSON</h1>"
    + "<h2>构建对象</h2>"
    + "<pre><code>导入 标准库.JSON;\n\n变量 用户 = JSON.创建对象();\nJSON.设置字符串(用户, \"姓名\", \"张三\");\nJSON.设置整数(用户, \"年龄\", 30);\nJSON.设置布尔(用户, \"活跃\", 1);\n变量 文本 = JSON.格式化(用户);\nIO.打印行(文本);\nJSON.删除(用户);</code></pre>"
    + "<h2>数组</h2>"
    + "<pre><code>变量 数组 = JSON.创建数组();\nJSON.数组添加字符串(数组, \"元素1\");\nJSON.数组添加整数(数组, 42);\n变量 长度 = JSON.数组长度(数组);\n变量 值 = JSON.数组获取字符串(数组, 0);</code></pre>"
    + 翻页("/docs/字符串.html", "字符串", "/docs/网络.html", "网络与 HTTP");
}
函数 文档_网络() : 字符串 {
    返回 "<h1>网络与 HTTP</h1>"
    + "<h2>HTTP 客户端</h2>"
    + "<pre><code>导入 标准库.HTTP;\n变量 响应 = HTTP.获取(\"https://example.com\");\n变量 结果值 = HTTP.发送(\"https://api.example.com\", 数据);  // POST\n变量 状态码 = HTTP.获取状态码(\"https://example.com\");</code></pre>"
    + "<blockquote class=warn>HTTP 模块名是<strong>大写</strong> <code>HTTP</code>，不是 <code>http</code>。</blockquote>"
    + "<h2>TCP / UDP</h2>"
    + "<pre><code>导入 标准库.网络 作为 网络;\n变量 连接 = 网络.TCP连接(\"127.0.0.1\", 6759, 5000);  // 主机,端口,超时ms\n网络.TCP写入(连接, \"你好\");\n变量 数据 = 网络.TCP读取(连接);\n网络.TCP关闭(连接);</code></pre>"
    + "<blockquote class=tip>要写完整的 HTTP 服务器，用 <a href=\"/docs/框架.html\">qi-web</a> 框架（122k RPS）。</blockquote>"
    + 翻页("/docs/JSON.html", "JSON", "/docs/大模型.html", "大模型");
}
函数 文档_大模型() : 字符串 {
    返回 "<h1>大模型</h1>"
    + "<p>标准库 <code>大模型</code> 模块走 OpenAI 兼容协议。更高层的 agent（自动工具派发/流式/重试）用 <a href=\"/docs/框架.html\">qi-harness</a>。</p>"
    + "<h2>底层直连</h2>"
    + "<pre><code>导入 标准库.大模型 作为 大模型;\n变量 会话 = 大模型.创建会话();\n大模型.设置配置(会话, \"base_url\", \"https://api.deepseek.com\");\n变量 回复 = 大模型.对话(会话, \"你好\");</code></pre>"
    + "<h2>用 qi-harness（推荐）</h2>"
    + "<pre><code>导入 Harness::{ 大模型, 配置系统提示, 开启会话, 创建代理, 简单问, 关闭代理 };\n变量 配置 = 大模型(\"https://api.deepseek.com\", 密钥, \"deepseek-chat\");\n变量 会话 = 开启会话(配置);\n变量 代理值 = 创建代理(\"助手\", 会话);\nIO.打印行(简单问(代理值, \"用一句话介绍奇语\"));\n关闭代理(代理值);</code></pre>"
    + "<blockquote class=tip>密钥从环境变量读，别硬编码：<code>系统.获取环境变量(\"QI_LLM_KEY\")</code>。</blockquote>"
    + 翻页("/docs/网络.html", "网络与 HTTP", "/docs/框架.html", "Web / CLI / Agent");
}

// ============================================================
// 文档页 —— 生态 + 参考
// ============================================================
函数 文档_框架() : 字符串 {
    返回 "<h1>Web / CLI / Agent 框架</h1>"
    + "<p>奇语自带三个用奇语写的框架，各有配套 <code>SKILL.md</code>（AI agent 技能）。</p>"
    + "<h2>qi-web — Web 框架</h2>"
    + "<p>Express / Fiber 风格，实测 ~122k RPS。</p>"
    + "<pre><code>导入 Web::{应用, 上下文, 响应, 创建应用, 配置, 获取, 文本, 运行应用};\n函数 处理(上下文值: 上下文) : 响应 { 返回 文本(\"ok\"); }\n函数 入口() {\n    变量 应用值 = 创建应用();\n    应用值 = 配置(应用值, \"127.0.0.1\", 6790);\n    应用值 = 获取(应用值, \"/\", 处理);\n    运行应用(应用值);\n}</code></pre>"
    + "<h2>qi-cli — 命令行框架</h2>"
    + "<p>Cobra 风格命令树、子命令、持久参数、执行钩子、自动帮助。</p>"
    + "<h2>qi-harness — LLM Agent 框架</h2>"
    + "<p>一行 <code>大模型(端点, 密钥, 模型)</code> 配置，自动工具派发循环（并行 tool_calls）、流式、追踪、重试。</p>"
    + 翻页("/docs/大模型.html", "大模型", "/docs/命令行工具.html", "命令行工具");
}
函数 文档_命令行工具() : 字符串 {
    返回 "<h1>命令行工具</h1>"
    + "<p>qi 编译器命令支持中英双形式。</p>"
    + "<table><tr><th>命令</th><th>说明</th></tr>"
    + "<tr><td><code>qi run 文件.qi</code></td><td>编译并运行</td></tr>"
    + "<tr><td><code>qi check 文件.qi</code></td><td>只检查语法（友好错误信息）</td></tr>"
    + "<tr><td><code>qi compile 文件.qi -o 输出</code></td><td>编译成原生可执行文件</td></tr>"
    + "<tr><td><code>qi format 文件.qi -i</code></td><td>格式化（就地）</td></tr>"
    + "<tr><td><code>qi info --version</code></td><td>编译器信息</td></tr></table>"
    + "<p>对应中文命令：<code>运行</code> / <code>检查</code> / <code>编译</code> / <code>格式化</code> / <code>信息</code>。</p>"
    + "<h2>调试</h2>"
    + "<pre><code>RUST_LOG=debug qi run 文件.qi   # 详细编译日志</code></pre>"
    + 翻页("/docs/框架.html", "框架", "/docs/保留字.html", "保留字与陷阱");
}
函数 文档_保留字() : 字符串 {
    返回 "<h1>保留字与陷阱</h1>"
    + "<h2>保留字地雷</h2>"
    + "<p>这些是关键字，<strong>不能</strong>当变量名 / 字段名 / 参数名，否则报「意外的标记」。最常被误用的：</p>"
    + "<pre><code>结果  类型  选项  通道  尝试  捕获  抛出  最终\n继续  跳出  返回  等待  异步  新建  选择  情况  在  作为  未来</code></pre>"
    + "<p>中文母语者很自然会想用 <code>变量 结果 = ...</code> / <code>变量 类型: 字符串</code> —— 会失败。改用别名：<code>计算结果</code> / <code>结果值</code> / <code>类型名</code> / <code>数据类型</code>。</p>"
    + "<blockquote class=tip>编译器会给 rustc 风格错误，看到「<code>X</code> 是 qi 的保留字」就换个名。</blockquote>"
    + "<h2>为什么不能降级成上下文关键字</h2>"
    + "<p><code>结果&lt;T,E&gt;</code> / <code>选项&lt;T&gt;</code> / <code>通道&lt;T&gt;</code> / <code>未来&lt;T&gt;</code> 是泛型类型语法，把这些词当标识符会和 <code>&lt;</code> 产生不可消解的 LALR(1) 歧义（<code>名字&lt;T&gt;</code> 泛型 vs <code>名字 &lt; 表达式</code> 比较）——这是解析器的理论限制（C++ 著名的「most vexing parse」）。</p>"
    + "<h2>其他注意</h2>"
    + "<ul><li>通用动词 <code>关闭</code> <code>打开</code> <code>读取</code> <code>长度</code> 现在<strong>可</strong>自由当函数名（不再被劫持），文件操作用完整名 <code>打开文件</code> / <code>关闭文件</code>。</li>"
    + "<li>打印用 <code>IO.打印行</code> / <code>IO.打印</code>。</li></ul>"
    + 翻页("/docs/命令行工具.html", "命令行工具", "/docs/常见问题.html", "常见问题");
}
函数 文档_常见问题() : 字符串 {
    返回 "<h1>常见问题</h1>"
    + "<h2>“意外的标记 结果 / 类型”</h2>"
    + "<p>它们是<a href=\"/docs/保留字.html\">保留字</a>，改用 <code>结果值</code> / <code>类型名</code> 等别名。</p>"
    + "<h2>“标准库.http 找不到”</h2>"
    + "<p>模块名大小写敏感，用 <code>标准库.HTTP</code>（大写）。</p>"
    + "<h2>“字符串模块不存在”</h2>"
    + "<p><code>字符串</code> 是类型关键字，但字符串模块同时注册为 <code>标准库.字符串</code> 和 <code>标准库.文本</code>，两个都能导入。</p>"
    + "<h2>读取文件拼接结果为空</h2>"
    + "<p>文件不存在时 <code>读取文件</code> 返回空串。先用 <code>字符串::字节长度</code> 检测。</p>"
    + "<h2>重复 _main 符号</h2>"
    + "<p>多文件项目里只有入口文件的 <code>入口()</code> 会变成 <code>@main</code>，被导入的模块的 <code>入口</code> 保持普通函数符号。</p>"
    + "<h2>异步看起来没真正并发</h2>"
    + "<p>复杂控制流内嵌 <code>等待</code> 目前会退化到同步包装（§4-4 状态机 ~70%）。简单 await 是真异步。</p>"
    + "<h2>端口用什么</h2>"
    + "<p>示例和部署都用随机高位端口（<code>3076</code> / <code>6759</code> / <code>43510</code>），别用 8080 / 3000 / 8000。</p>"
    + 翻页("/docs/保留字.html", "保留字与陷阱", "", "");
}

// ============================================================
// 文档页 —— 给 AI / Agent（LLM 友好的浓缩参考）
// ============================================================
函数 文档_给AI() : 字符串 {
    返回 "<h1>给 AI / Agent</h1>"
    + "<p class=lead>这页是给 AI 编码助手看的浓缩规则。让 LLM 一次性读完就能正确生成奇语代码——避开所有已知陷阱。</p>"
    + "<blockquote class=tip>纯文本版（适合喂给模型 / 抓取）：<a href=\"/llms.txt\">/llms.txt</a>。可安装的 agent skill：<code>npx skills add https://github.com/qilang-project/qi-lang</code>。</blockquote>"
    + "<h2>一句话定位</h2>"
    + "<p>奇语（Qi）= 100% 中文关键字、编译到 LLVM 原生码的系统级语言。语法像 Rust/Go 的中文化版本。</p>"
    + "<h2>骨架（每个程序都要）</h2>"
    + "<pre><code>包 主程序;\n导入 标准库.输入输出 作为 IO;\n函数 入口() {\n    IO.打印行(\"你好\");\n}</code></pre>"
    + "<ul><li>入口函数必须叫 <code>入口</code>（不是 主函数 / main）</li>"
    + "<li>打印用 <code>IO.打印行</code> / <code>IO.打印</code></li>"
    + "<li>语句以 <code>;</code> 结尾；支持中英标点（<code>；，：（）</code> 都行）</li></ul>"
    + "<h2>最高频错误（务必避免）</h2>"
    + "<ol><li><strong>保留字当变量名</strong>：<code>结果 类型 选项 通道 尝试 返回 等待 异步 新建 选择 情况 在 作为 未来 继续 跳出 捕获 抛出 最终</code> 不能做标识符。要用就改名：<code>结果值 类型名</code>。</li>"
    + "<li><strong>整数是 i64 不是 i32</strong>。</li>"
    + "<li><strong>方法是 Go 风格</strong>：<code>函数 (自己 类型) 方法名(...) { }</code>，不是 <code>方法 类型.名</code>。</li>"
    + "<li><strong>读取文件失败返回空串</strong>（不是 NULL）；用 <code>字符串::字节长度(x)==0</code> 判失败。<code>写入文件</code> 返回 1=成功。</li>"
    + "<li><strong>HTTP 模块大写</strong> <code>标准库.HTTP</code>。</li>"
    + "<li><strong>跨包用 destructure 导入</strong>：<code>导入 Web::{创建应用, 启动}</code>，不支持 <code>Web::函数()</code>。</li>"
    + "<li><strong>端口</strong>用随机高位（3076/6759/43510），不要 8080/3000。</li></ol>"
    + "<h2>类型速查</h2>"
    + "<pre><code>整数(i64)  浮点数(f64)  布尔(真/假)  字符串  字节  短整数  空</code></pre>"
    + "<h2>常用模式</h2>"
    + "<pre><code>// 变量\n变量 名: 字符串 = \"x\";\n变量 数: 整数 = 1;\n常量 PI = 3.14;\n// 控制流\n如果 (n &lt; 2) { 返回 n; } 否则 { 返回 n - 1; }\n当 (i &lt; 10) { i = i + 1; }\n对于 i 在 0..10 { IO.打印(i); }\n// 函数\n函数 加(x: 整数, y: 整数) : 整数 { 返回 x + y; }\n// 结构体\n类型 点 { x: 浮点数, y: 浮点数 }\n变量 p = (点 { x: 1.0, y: 2.0 });\n// 异步\n函数 双(v: 整数) : 未来&lt;整数&gt; { 返回 v * 2; }\n变量 r: 整数 = 等待 双(21);\n// 数字转字符串拼接\n变量 行 = \"n=\" + 整数转字符串(数);</code></pre>"
    + "<h2>三个框架（用奇语写）</h2>"
    + "<ul><li><strong>qi-web</strong>：<code>导入 Web::{创建应用, 配置, 获取, 文本, 运行应用}</code>，handler 签名 <code>函数(上下文): 响应</code>。</li>"
    + "<li><strong>qi-cli</strong>：<code>导入 CLI::{创建应用, 创建命令, 执行}</code>，handler 签名 <code>函数(上下文): 整数</code>，链式 API 要回写。</li>"
    + "<li><strong>qi-harness</strong>：<code>导入 Harness::{大模型, 开启会话, 创建代理, 简单问, 关闭代理}</code>，密钥从环境变量读。</li></ul>"
    + "<p>每个框架带 <code>SKILL.md</code>，生成对应代码前先读：<a href=\"https://github.com/qilang-project/qi-web/blob/main/SKILL.md\">qi-web</a> · <a href=\"https://github.com/qilang-project/qi-cli/blob/main/SKILL.md\">qi-cli</a> · <a href=\"https://github.com/qilang-project/qi-harness/blob/main/SKILL.md\">qi-harness</a> · <a href=\"https://github.com/qilang-project/qi-lang/blob/main/SKILL.md\">基础语言</a>。</p>"
    + "<h2>验证生成的代码</h2>"
    + "<pre><code>qi check 文件.qi   # 只查语法，报 rustc 风格错误\nqi run 文件.qi     # 编译运行</code></pre>"
    + 翻页("/docs/常见问题.html", "常见问题", "", "");
}

// llms.txt —— 给爬虫 / 模型抓取的纯文本摘要
函数 LLMS文本() : 字符串 {
    返回 "# 奇语 Qi (qilang)\n\n"
    + "> 100% 中文关键字、编译到 LLVM 原生码的系统级编程语言。语法类似 Rust/Go 的中文化版本。官网 https://qilang-project.github.io/\n\n"
    + "## 骨架\n包 主程序;\n导入 标准库.输入输出 作为 IO;\n函数 入口() { IO.打印行(\"你好\"); }\n\n"
    + "## 关键规则\n"
    + "- 入口函数必须叫 入口。打印用 IO.打印行 / IO.打印。\n"
    + "- 保留字不能当变量名：结果 类型 选项 通道 尝试 返回 等待 异步 新建 选择 情况 在 作为 未来 继续 跳出 捕获 抛出 最终。要用改名如 结果值。\n"
    + "- 整数 = i64（不是 i32）。布尔字面量 真/假。\n"
    + "- 方法 Go 风格：函数 (自己 类型) 方法名(...) { }。\n"
    + "- 读取文件失败返回空串（不是 NULL），用 字符串::字节长度(x)==0 判失败；写入文件 1=成功。\n"
    + "- HTTP 模块大写：标准库.HTTP。\n"
    + "- 跨包 destructure 导入：导入 Web::{创建应用, 启动}。不支持 Web::函数()。\n"
    + "- 端口用随机高位 3076/6759/43510，不要 8080/3000。\n\n"
    + "## 类型\n整数(i64) 浮点数(f64) 布尔(真/假) 字符串 字节 短整数 空\n\n"
    + "## 控制流\n如果(cond){...}否则{...} | 当(cond){...} | 对于 i 在 0..10{...} | 匹配 v { 1=>..., _=>... }\n\n"
    + "## 异步\n函数 双(v: 整数) : 未来<整数> { 返回 v*2; }  变量 r: 整数 = 等待 双(21);\n\n"
    + "## 框架\n"
    + "qi-web（Web，~122k RPS）: 导入 Web::{创建应用,配置,获取,文本,运行应用}; handler=函数(上下文):响应\n"
    + "qi-cli（Cobra 风格）: 导入 CLI::{创建应用,创建命令,执行}; handler=函数(上下文):整数\n"
    + "qi-harness（LLM agent）: 导入 Harness::{大模型,开启会话,创建代理,简单问,关闭代理}\n\n"
    + "## Agent skills\n"
    + "npx skills add https://github.com/qilang-project/qi-lang  (基础语言)\n"
    + "各框架仓库根目录有 SKILL.md。\n\n"
    + "## 命令\nqi check 文件.qi (查语法) | qi run 文件.qi (运行) | qi compile 文件.qi -o out\n";
}

// ============================================================
// 主入口
// ============================================================
函数 写文件(路径: 字符串, 内容: 字符串) {
    变量 状态: 整数 = IO::写入文件(路径, 内容);
    如果 (状态 == 1) { IO.打印行("  ✓ " + 路径); } 否则 { IO.打印行("  ✗ " + 路径); }
}
函数 写文档(文件名: 字符串, 标题: 字符串, 描述: 字符串, 键: 字符串, 正文: 字符串) {
    写文件("../docs/" + 文件名, 包裹页面(标题, 描述, "docs", 文档侧栏(键), 正文));
}

函数 入口() {
    IO.打印行("生成奇语站点...");
    IO::创建目录("../blog");
    IO::创建目录("../docs");
    变量 空串: 字符串 = "";

    // 博客
    写文件("../blog/index.html", 包裹页面("博客", "奇语设计与实现笔记", "blog", 空串, 博客首页正文()));
    写文件("../blog/为什么用中文关键字.html", 包裹页面("为什么用中文关键字", "母语编程降低认知负荷", "blog", 空串, 文章_中文关键字()));
    写文件("../blog/qi-web-122k-rps.html", 包裹页面("qi-web 122k RPS 之路", "热路径 Rust 化性能优化", "blog", 空串, 文章_性能()));
    写文件("../blog/编译器友好错误.html", 包裹页面("给编译器一张人话嘴", "rustc 风格错误信息", "blog", 空串, 文章_错误()));

    // 文档 —— 开始
    写文档("index.html", "文档", "奇语 Qi 官方文档", "index", 文档_简介());
    写文档("安装.html", "安装", "安装奇语编译器", "install", 文档_安装());
    写文档("第一个程序.html", "第一个程序", "你好世界", "first", 文档_第一个程序());
    // 文档 —— 语言
    写文档("基础语法.html", "变量与类型", "变量/类型/运算符/数组", "syntax", 文档_基础语法());
    写文档("函数与方法.html", "函数与方法", "函数/高阶函数/Go 风格方法", "func", 文档_函数());
    写文档("控制流.html", "控制流", "条件/循环/匹配", "flow", 文档_控制流());
    写文档("结构体与枚举.html", "结构体与枚举", "结构体/方法/枚举", "struct", 文档_结构体());
    写文档("错误处理.html", "错误处理", "尝试捕获/FFI 返回约定", "err", 文档_错误处理());
    写文档("异步.html", "异步与协程", "未来/等待/通道/select", "async", 文档_异步());
    写文档("包与模块.html", "包与模块", "导入系统/跨包", "module", 文档_包与模块());
    // 文档 —— 标准库
    写文档("标准库.html", "标准库总览", "25+ 标准库模块", "stdlib", 文档_标准库());
    写文档("输入输出.html", "输入输出与文件", "打印/文件读写", "io", 文档_输入输出());
    写文档("字符串.html", "字符串", "查找/子串/替换/分割", "str", 文档_字符串());
    写文档("JSON.html", "JSON", "对象/数组构建", "json", 文档_JSON());
    写文档("网络.html", "网络与 HTTP", "HTTP/TCP/UDP", "net", 文档_网络());
    写文档("大模型.html", "大模型", "OpenAI 兼容 LLM", "llm", 文档_大模型());
    // 文档 —— 生态 + 参考
    写文档("框架.html", "框架", "qi-web / qi-cli / qi-harness", "frameworks", 文档_框架());
    写文档("命令行工具.html", "命令行工具", "qi run/check/compile/format", "tool", 文档_命令行工具());
    写文档("保留字.html", "保留字与陷阱", "保留字地雷 + 原因", "reserved", 文档_保留字());
    写文档("常见问题.html", "常见问题", "FAQ", "faq", 文档_常见问题());
    写文档("给AI.html", "给 AI / Agent", "LLM 友好的奇语速成规则", "ai", 文档_给AI());

    // 给模型 / 爬虫的纯文本摘要（站点根）
    写文件("../llms.txt", LLMS文本());

    IO.打印行("完成。");
}
